MUSKI_DATA_DIR=/var/lib/muskitakip
MUSKI_DB=/var/lib/muskitakip/muski.db
MUSKI_BACKUP_DIR=/var/lib/muskitakip/backups
MUSKI_WEB_HOST=0.0.0.0
MUSKI_WEB_PORT=5090
MUSKI_CHROME_BINARY=/opt/muskitakip/chromium/chromium
MUSKI_CHROMEDRIVER=/opt/muskitakip/chromium/chromedriver
HOME=/var/lib/muskitakip
PYTHONUNBUFFERED=1
