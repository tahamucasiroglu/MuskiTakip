[Unit]
Description=MUSKİ Kesinti Takip - web arayüzü
After=network-online.target
Wants=network-online.target

[Service]
User=muskitakip
Group=muskitakip
EnvironmentFile=/etc/muskitakip.env
WorkingDirectory=/opt/muskitakip/app
ExecStart=/opt/muskitakip/venv/bin/python -m muskitakip.web
Restart=always
RestartSec=5
MemoryMax=400M

[Install]
WantedBy=multi-user.target
