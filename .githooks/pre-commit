#!/usr/bin/env bash
# Commit'e gizli bilgi (Telegram bot token'ı, özel anahtar, .env dosyası) girmesini engeller.
# Etkinleştirme (bir kez): git config core.hooksPath .githooks
# Not: "grep -q" + pipefail büyük diff'lerde SIGPIPE ile eşleşmeyi kaçırabildiği için çıktı dosyaya alınıp taranır.
set -eu
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
git diff --cached -U0 --no-color | grep -E '^\+' > "$tmp" || true

if grep -E '[0-9]{8,10}:[A-Za-z0-9_-]{35}' "$tmp" > /dev/null; then
  echo "HATA: Commit'te Telegram bot token'ına benzeyen bir değer var. Kaldırıp tekrar deneyin." >&2
  exit 1
fi
if grep -E 'BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY' "$tmp" > /dev/null; then
  echo "HATA: Commit'te özel anahtar var." >&2
  exit 1
fi
if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(\.env|[^/]*telegram[^/]*\.env)$'; then
  echo "HATA: Gizli ayar dosyası commit'lenmek üzere (yukarıda). Kaldırın." >&2
  exit 1
fi
exit 0
